# ExportPilot PayFlow AI — Environment Configuration Template
# Copy this file to .env.local for local development

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Supabase PostgreSQL (Cloud or Local Docker)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# PayPal Orders v2 Sandbox Credentials
# https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here
PAYPAL_ENVIRONMENT=sandbox

# ==============================================================================
# AI Extraction Providers (Gemini Free Tier or OpenRouter Free Models)
# Deterministic offline fallback will activate automatically if keys are absent
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_PROVIDER_DEFAULT=auto
